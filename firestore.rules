rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Bootstrapped Admin using runtime email from user
      return isSignedIn() && (
        request.auth.token.email == 'admin@vajranad.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 2. Members Collection
    match /members/{memberId} {
      // Allow read for authenticated users to view profiles or verify memberships
      allow read: if true;
      // Allow create, update, and delete
      allow create, update, delete: if true;
    }

    // 3. Attendance Sessions
    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. Attendance Records
    match /records/{recordId} {
      allow read: if true;
      allow write: if true;
    }

    // 5. Notices Collection
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if true;
    }

    // 6. Gallery Collection
    match /gallery/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // 7. Folders Collection
    match /folders/{folderId} {
      allow read: if true;
      allow write: if true;
    }

    // 8. Countdowns Collection
    match /countdowns/{countdownId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
